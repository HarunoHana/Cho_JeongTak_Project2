                    "numoutlets": 0,
                    "patching_rect": [ 49.333333333333485, 1404.0, 150.0, 20.0 ],
                    "text": "D4.calc~-example-minimal",
                    "textcolor": [ 0.666666666666667, 0.0, 0.0, 1.0 ]
                }
            },
            {
                "box": {
                    "handoff": "",
                    "id": "obj-32",
                    "maxclass": "ubutton",
                    "numinlets": 1,
                    "numoutlets": 4,
                    "outlettype": [ "bang", "bang", "", "int" ],
