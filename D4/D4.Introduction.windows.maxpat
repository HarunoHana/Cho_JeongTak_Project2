                    "patching_rect": [ 176.33333333333334, 271.0, 275.0, 36.0 ],
                    "text": ";\r\nmax launch_browser http://ico.bukvic.net/main/d4/"
                }
            },
            {
                "box": {
                    "handoff": "",
